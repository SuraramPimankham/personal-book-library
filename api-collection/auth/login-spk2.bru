meta {
  name: Login (spk2)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "spk2",
    "password": "password123"
  }
}

script:post-response {
  const data = res.getBody();
  if (data.token) {
    bru.setEnvVar("spk2Token", data.token);
    bru.setEnvVar("token", data.token);
  }
}

