meta {
  name: Login (admin)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "admin",
    "password": "password123"
  }
}

script:post-response {
  const data = res.getBody();
  if (data.token) {
    bru.setEnvVar("adminToken", data.token);
    bru.setEnvVar("token", data.token);
  }
}

docs {
  UC-01 — เข้าสู่ระบบ admin
  เก็บ token ใน adminToken และ token (ใช้กับ request ถัดไป)
}
